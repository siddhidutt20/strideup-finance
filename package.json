{
  "name": "strideup-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "StrideUp Finance — upload an invoice, watch the month update.",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/src/server.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "concurrently": "^9.1.0"
  }
}
