# ─────────────────────────────────────────────────────────────
# StrideUp Finance — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

PORT=4100
NODE_ENV=development

# Signs the session cookie. MUST be long and random.
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────
# On Vercel: Storage → Create Database → Neon. It sets DATABASE_URL for you.
# Locally: leave blank to use an embedded Postgres under ./data/pg.
DATABASE_URL=

# ── The one account ──────────────────────────────────────────
# This app has no registration. The account below is created on first boot.
# Changing OWNER_PASSWORD and redeploying resets the password — that is the
# recovery path if it is ever forgotten.
OWNER_EMAIL=you@strideup.org
OWNER_PASSWORD=change-me-strong-password
OWNER_NAME=Your Name

# ── Reading invoices and receipts ────────────────────────────
# Without a key the dashboard still works; only automatic document reading
# is disabled. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Finance settings ─────────────────────────────────────────
# Every figure on the dashboard is reported in this currency. Set it to the
# one your business actually runs in — if most of your invoices are in INR,
# set INR and they need no conversion at all.
FINANCE_BASE_CURRENCY=USD
# Extractions below this confidence are flagged for a look. They still land in
# the ledger — the month's totals stay complete either way.
FINANCE_CONFIDENCE_FLOOR=0.85

# Where daily exchange rates come from, for documents in another currency.
# The default is free and needs no key. Rates are cached per day, and a
# lookup that fails never blocks an import — the entry is recorded in its own
# currency and flagged instead.
# FINANCE_FX_URL=https://api.frankfurter.dev/v1/{date}?base={from}&symbols={to}

# Vite dev server origin (local development only).
CLIENT_ORIGIN=http://localhost:5273
